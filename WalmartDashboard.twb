      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0qbsnel1okzhzo12v7m2f0089tjp].[usr:Calculation_5191946740923158528:qk]&quot;' value='Revenue' />
          <alias key='&quot;[federated.0qbsnel1okzhzo12v7m2f0089tjp].[usr:Calculation_5191946740923305985:qk]&quot;' value='Transaction' />
        </aliases>
      </column>
      <column caption='Revenue' datatype='real' name='[Calculation_5144025626125848577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_price])' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_5144025626125975554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit_margin] * [total_price])' />
      </column>
      <column caption='Transactions' datatype='integer' name='[Calculation_5144025626126045187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([invoice_id])' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_5144025626126073860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit_margin] * [total_price]) / SUM([total_price]) * 100' />
      </column>
      <column caption='Year-Month' datatype='datetime' name='[Calculation_5144025626132901893]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date])' />
      </column>
      <column caption='Revenue %' datatype='real' name='[Calculation_5191946740923158528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_price]) / WINDOW_SUM(SUM([total_price])) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Transaction %' datatype='real' name='[Calculation_5191946740923305985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([invoice_id]) / WINDOW_SUM(COUNT([invoice_id])) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Time Of Day' datatype='string' name='[Calculation_5191946740924518402]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;, [time]) &gt;= 6 AND DATEPART(&apos;hour&apos;, [time]) &lt; 12 THEN &quot;Morning (6–11)&quot;&#10;ELSEIF DATEPART(&apos;hour&apos;, [time]) &gt;= 12 AND DATEPART(&apos;hour&apos;, [time]) &lt; 18 THEN &quot;Afternoon (12–17)&quot;&#10;ELSEIF DATEPART(&apos;hour&apos;, [time]) &gt;= 18 AND DATEPART(&apos;hour&apos;, [time]) &lt; 24 THEN &quot;Evening (18–23)&quot;&#10;ELSE &quot;Night (0–5)&quot;&#10;END' />
      </column>
